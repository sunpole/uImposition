{
  "id": "r3-operator-workspace-schemes-pdf",
  "path": "/app/",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "assertions": [
    {
      "selector": "#orderTitle",
      "text": "Выберите рабочий пресет"
    }
  ],
  "beforeDownload": [
    {
      "action": "wait",
      "timeoutMs": 900
    },
    {
      "action": "click",
      "selector": ".quick-comparison [data-open-screen='alternatives']"
    },
    {
      "action": "click",
      "selector": "#alternativesList .alternative-card:nth-child(2) [data-select-plan]"
    },
    {
      "action": "click",
      "selector": ".topbar [data-open-screen='layout']"
    },
    {
      "action": "wait",
      "timeoutMs": 450
    }
  ],
  "download": {
    "selector": "[data-workspace-pdf='schemes']",
    "fileNamePattern": "^uImposition-uniform-r(0|90)-(paper-minimum|dedicated-pairs)-schemes\\.pdf$",
    "artifact": "uimposition-r3-selected-plan-schemes.pdf",
    "expectedPages": 2
  },
  "afterDownloadAssertions": [
    {
      "selector": "[data-workspace-export-status]",
      "text": "Скачан"
    }
  ],
  "beforeScreenshotAssertions": [
    {
      "selector": "#layoutDetails",
      "text": "PDF выбранного плана"
    },
    {
      "selector": "[data-workspace-export-status]",
      "text": "Скачан"
    }
  ],
  "screenshotSelector": "#layoutDetails",
  "screenshot": "uimposition-r3-selected-plan-schemes-download.png"
}
