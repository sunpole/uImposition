{
  "id": "m7-user-order-plan-catalog-mobile",
  "path": "/",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "assertions": [
    {
      "selector": "#applicationShell",
      "text": "Параметры заказа"
    },
    {
      "selector": "[data-app-screen-target='order']",
      "text": "Заказ"
    }
  ],
  "beforeScreenshot": [
    {
      "action": "fill",
      "selector": "#ordersInput",
      "value": "A | 100 | 2\nB | 100 | 2\nC | 100 | 2"
    },
    {
      "action": "fill",
      "selector": "#userFrontColors",
      "value": "4"
    },
    {
      "action": "fill",
      "selector": "#userBackColors",
      "value": "1"
    },
    {
      "action": "fill",
      "selector": "#pricingGrammageGsm",
      "value": "130"
    },
    {
      "action": "fill",
      "selector": "#pricingPaperPricePerKg",
      "value": "4"
    },
    {
      "action": "fill",
      "selector": "#pricingColorPlatePrice",
      "value": "15"
    },
    {
      "action": "fill",
      "selector": "#pricingLayoutFormPreparationPrice",
      "value": "2"
    },
    {
      "action": "wait",
      "timeoutMs": 500
    },
    {
      "action": "click",
      "selector": "[data-app-screen-target='alternatives']"
    },
    {
      "action": "wait",
      "timeoutMs": 250
    },
    {
      "action": "hide",
      "selector": ".app-header"
    },
    {
      "action": "hide",
      "selector": ".app-navigation"
    },
    {
      "action": "hide",
      "selector": ".app-action-bar"
    }
  ],
  "beforeScreenshotAssertions": [
    {
      "selector": "[data-app-screen='alternatives']",
      "text": "Варианты производства"
    },
    {
      "selector": "#userProductionPlans",
      "text": "4 варианта"
    },
    {
      "selector": "#userProductionPlans",
      "text": "Все · 4"
    },
    {
      "selector": "#userProductionPlans",
      "text": "показано"
    },
    {
      "selector": "[data-plan-id='uniform-r90-paper-minimum']",
      "text": "20"
    },
    {
      "selector": "[data-plan-id='uniform-r90-dedicated-pairs']",
      "text": "21"
    },
    {
      "selector": "[data-plan-id='uniform-r90-dedicated-pairs']",
      "text": "Pareto"
    },
    {
      "selector": "[data-plan-id='uniform-r90-dedicated-pairs'] [data-select-user-plan]",
      "text": "Выбрать"
    }
  ],
  "screenshotSelector": "[data-app-screen='alternatives']",
  "screenshot": "uimposition-m7-5-user-order-plan-catalog-mobile.png"
}
