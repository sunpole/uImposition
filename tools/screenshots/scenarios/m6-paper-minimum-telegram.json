{
  "id": "m6-paper-minimum-telegram",
  "path": "/?demo=control",
  "viewport": { "width": 1280, "height": 900 },
  "assertions": [
    { "selector": ".brand", "text": "v0.6.0-alpha" },
    { "selector": "#paperSolutionStatus", "text": "Минимум бумаги доказан" },
    { "selector": "#paperOptimalSheets", "text": "305" },
    { "selector": "#paperSavings", "text": "90" },
    { "selector": "#paperOptimalForms", "text": "112" },
    { "selector": "#paperOptimalPressPasses", "text": "610" },
    { "selector": "#paperOptimalPairOverrun", "text": "10" },
    { "selector": "#paperOptimalProof", "text": "меньше бумаги невозможно" },
    { "selector": ".paper-warning", "text": "с 8 до 112" }
  ],
  "beforeScreenshot": [
    { "action": "click", "selector": "#settingsToggle" },
    { "action": "waitForHidden", "selector": "#toast", "timeoutMs": 10000 },
    { "action": "wait", "timeoutMs": 250 }
  ],
  "screenshotSelector": "#paperSolution",
  "screenshot": "uimposition-v0-6-0-alpha-paper-minimum-telegram.png"
}
