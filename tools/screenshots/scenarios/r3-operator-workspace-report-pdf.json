{
  "id": "r3-operator-workspace-report-pdf",
  "path": "/app/",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "assertions": [
    {
      "selector": "#orderTitle",
      "text": "Выберите рабочий пресет"
    }
  ],
  "beforeDownload": [
    {
      "action": "wait",
      "timeoutMs": 900
    },
    {
      "action": "click",
      "selector": ".topbar [data-open-screen='layout']"
    },
    {
      "action": "wait",
      "timeoutMs": 450
    }
  ],
  "download": {
    "selector": "[data-workspace-pdf='report']",
    "fileNamePattern": "^uImposition-uniform-r(0|90)-(paper-minimum|dedicated-pairs|work-and-turn-dedicated-pairs)-production-report\\.pdf$",
    "artifact": "uimposition-r3-selected-plan-production-report.pdf",
    "expectedPages": 3
  },
  "afterDownloadAssertions": [
    {
      "selector": "[data-workspace-export-status]",
      "text": "Скачан"
    }
  ],
  "beforeScreenshotAssertions": [
    {
      "selector": "[data-workspace-pdf='report']",
      "text": "Отчёт PDF"
    },
    {
      "selector": "[data-workspace-export-status]",
      "text": "Скачан"
    }
  ],
  "screenshotSelector": ".screen--layout .screen-heading__actions",
  "screenshot": "uimposition-r3-selected-plan-report-download.png"
}
