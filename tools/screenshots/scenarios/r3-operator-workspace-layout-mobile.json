{
  "id": "r3-operator-workspace-layout-mobile",
  "path": "/app/",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "assertions": [
    {
      "selector": "#orderTitle",
      "text": "Выберите рабочий пресет"
    },
    {
      "selector": "#pricingButton",
      "text": "Прайс"
    }
  ],
  "beforeScreenshot": [
    {
      "action": "wait",
      "timeoutMs": 900
    },
    {
      "action": "click",
      "selector": "#addProductButton"
    },
    {
      "action": "fill",
      "selector": "[data-product-row]:nth-child(2) [data-product-field='print.backColors']",
      "value": "1"
    },
    {
      "action": "wait",
      "timeoutMs": 350
    },
    {
      "action": "fill",
      "selector": "[data-product-row]:nth-child(1) [data-product-field='print.backColors']",
      "value": "1"
    },
    {
      "action": "waitForHidden",
      "selector": "#calculationError",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "selector": "[data-priority='paper']"
    },
    {
      "action": "wait",
      "timeoutMs": 900
    },
    {
      "action": "click",
      "selector": "[data-mobile-screen='layout']"
    },
    {
      "action": "click",
      "selector": "[data-acceptance-layout='both']"
    },
    {
      "action": "wait",
      "timeoutMs": 500
    }
  ],
  "beforeScreenshotAssertions": [
    {
      "selector": "#calculationError",
      "hidden": true
    },
    {
      "selector": "#layoutDetails",
      "text": "Выбранный план"
    },
    {
      "selector": ".layout-pair",
      "text": "Оборот · зеркально"
    },
    {
      "selector": "[data-mobile-screen='layout']",
      "text": "Схема"
    },
    {
      "selector": "[data-workspace-pdf='schemes']",
      "text": "Схемы PDF"
    },
    {
      "selector": "[data-workspace-pdf='report']",
      "text": "Отчёт PDF"
    }
  ],
  "pageAssertions": {
    "noHorizontalOverflow": true,
    "layoutFitsCanvas": true,
    "mirroredBackDom": true
  },
  "screenshotSelector": ".screen--layout",
  "screenshot": "uimposition-r3-operator-workspace-layout-mobile.png"
}
