{
  "id": "r3-control-order-20-products",
  "path": "/app/",
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "assertions": [
    {
      "selector": "[data-txt-import-controls]",
      "text": "Тест: 20 файлов · 1+1"
    }
  ],
  "beforeScreenshot": [
    {
      "action": "wait",
      "timeoutMs": 900
    },
    {
      "action": "click",
      "selector": "[data-txt-import-controls] button:first-child"
    },
    {
      "action": "wait",
      "timeoutMs": 2200
    },
    {
      "action": "click",
      "selector": ".topbar__nav [data-open-screen='order']"
    }
  ],
  "beforeScreenshotAssertions": [
    {
      "selector": "#productList [data-product-row]:nth-child(1) [data-product-field='name']",
      "value": "70"
    },
    {
      "selector": "#productList [data-product-row]:nth-child(20) [data-product-field='name']",
      "value": "20"
    },
    {
      "selector": "#productList [data-product-row]:nth-child(20) [data-product-field='pages']",
      "value": "3"
    },
    {
      "selector": "#productList [data-product-row]:nth-child(1) [data-product-field='print.frontColors']",
      "value": "1"
    },
    {
      "selector": "#productList [data-product-row]:nth-child(1) [data-product-field='print.backColors']",
      "value": "1"
    },
    {
      "selector": "#calculationError",
      "hidden": true
    }
  ],
  "pageAssertions": {
    "noHorizontalOverflow": true
  },
  "screenshotSelector": ".products-panel",
  "screenshot": "uimposition-r3-control-order-20-products.png"
}
