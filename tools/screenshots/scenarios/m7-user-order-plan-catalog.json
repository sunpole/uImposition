{
  "id": "m7-user-order-plan-catalog",
  "path": "/",
  "viewport": { "width": 1440, "height": 1180 },
  "assertions": [
    { "selector": "#applicationShell", "text": "Параметры заказа" },
    { "selector": "[data-app-screen='order']", "text": "Лист, изделие, файлы" }
  ],
  "beforeScreenshot": [
    { "action": "fill", "selector": "#ordersInput", "value": "A | 100 | 2\nB | 100 | 2\nC | 100 | 2" },
    { "action": "fill", "selector": "#userFrontColors", "value": "4" },
    { "action": "fill", "selector": "#userBackColors", "value": "1" },
    { "action": "fill", "selector": "#pricingGrammageGsm", "value": "130" },
    { "action": "fill", "selector": "#pricingPaperPricePerKg", "value": "4" },
    { "action": "fill", "selector": "#pricingColorPlatePrice", "value": "15" },
    { "action": "fill", "selector": "#pricingLayoutFormPreparationPrice", "value": "2" },
    { "action": "wait", "timeoutMs": 500 },
    { "action": "click", "selector": "[data-app-screen-target='alternatives']" },
    { "action": "wait", "timeoutMs": 250 }
  ],
  "beforeScreenshotAssertions": [
    { "selector": "[data-app-screen='alternatives']", "text": "Варианты производства" },
    { "selector": "#userProductionPlans", "text": "5 варианта" },
    { "selector": "#userProductionPlans", "text": "Полный набор внутри заявленной области" },
    { "selector": "#userProductionPlans", "text": "Свой оборот" },
    { "selector": "#userProductionPlans", "text": "чётным числом колонок" },
    { "selector": "#userProductionPlans", "text": "Pareto" },
    { "selector": "[data-plan-id='uniform-r90-paper-minimum']", "text": "20" },
    { "selector": "[data-plan-id='uniform-r90-dedicated-pairs']", "text": "21" },
    { "selector": "[data-plan-id='uniform-r90-work-and-turn-dedicated-pairs']", "text": "Свой оборот" },
    { "selector": "[data-plan-id='uniform-r90-work-and-turn-dedicated-pairs']", "text": "12" },
    { "selector": "[data-plan-id='uniform-r90-paper-minimum']", "text": "BYN" }
  ],
  "screenshotSelector": "[data-app-screen='alternatives']",
  "screenshot": "uimposition-m7-5-user-order-plan-catalog.png"
}
