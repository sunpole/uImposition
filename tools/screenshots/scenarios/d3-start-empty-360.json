    "width": 360,
    "height": 800
  },
  "assertions": [
    {
      "selector": "#currentPresetButton",
      "text": "616×446"
    },
    {
      "selector": "#draftRow"
    },
    {
      "selector": "[data-mobile-screen='order']",
      "text": "Заказ"
