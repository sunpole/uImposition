{
  "id": "ux-comparison-workspace-interactions",
  "path": "/",
  "viewport": { "width": 1440, "height": 1000 },
  "assertions": [
    { "selector": "#applicationShell", "text": "Параметры заказа" }
  ],
  "beforeScreenshot": [
    { "action": "fill", "selector": "#ordersInput", "value": "A | 100 | 2\nB | 100 | 2\nC | 100 | 2" },
    { "action": "fill", "selector": "#userFrontColors", "value": "4" },
    { "action": "fill", "selector": "#userBackColors", "value": "1" },
    { "action": "fill", "selector": "#pricingGrammageGsm", "value": "130" },
    { "action": "fill", "selector": "#pricingPaperPricePerKg", "value": "4" },
    { "action": "fill", "selector": "#pricingColorPlatePrice", "value": "15" },
    { "action": "fill", "selector": "#pricingLayoutFormPreparationPrice", "value": "2" },
    { "action": "wait", "timeoutMs": 500 },
    { "action": "click", "selector": "[data-app-screen-target='alternatives']" },
    { "action": "click", "selector": "[data-comparison-status='recommended']" },
    { "action": "wait", "timeoutMs": 100 },
    { "action": "click", "selector": "[data-comparison-status='all']" },
    { "action": "click", "selector": "[data-comparison-differences]" },
    { "action": "click", "selector": "[data-comparison-sort='estimatedTotalCost']" },
    { "action": "click", "selector": "[data-plan-id='uniform-r90-dedicated-pairs'] [data-select-user-plan]" },
    { "action": "wait", "timeoutMs": 250 }
  ],
  "beforeScreenshotAssertions": [
    { "selector": "#userProductionPlans", "text": "Сравнение производственных вариантов" },
    { "selector": "#userProductionPlans", "text": "4 варианта" },
    { "selector": "#userProductionPlans", "text": "Полный набор внутри текущей области" },
    { "selector": "#userProductionPlans", "text": "4 готовых планов использовано повторно" },
    { "selector": "#userProductionPlans", "text": "0 планов построено заново" },
    { "selector": "[data-plan-id='uniform-r90-dedicated-pairs']", "text": "Выбран" },
    { "selector": ".comparison-table tbody tr:first-child[data-plan-id='uniform-r90-dedicated-pairs']", "text": "240,05 BYN" },
    { "selector": "[data-comparison-differences]", "text": "" }
  ],
  "screenshotSelector": "[data-app-screen='alternatives']",
  "screenshot": "uimposition-ux-3-comparison-workspace.png"
}
