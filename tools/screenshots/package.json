{
  "name": "uimposition-screenshot-tools",
  "version": "0.7.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Isolated Playwright tooling for factual uImposition release screenshots and PDF verification.",
  "scripts": {
    "capture": "node prepare-artifacts.mjs && playwright test --config=playwright.config.mjs",
    "capture:list": "playwright test --config=playwright.config.mjs --list"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  },
  "engines": {
    "node": ">=22"
  }
}
